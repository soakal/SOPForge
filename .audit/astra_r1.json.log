src/pipeline/server.py:619:         """Render every output format + the review report from finished
src/pipeline/server.py:620:         step_results and annotated images. Shared by both generation modes.
src/pipeline/server.py:621: 
src/pipeline/server.py:622:         polish_override: a PolishMode ("off"/"local"/"haiku") for this job
src/pipeline/server.py:623:         only, resolved via resolve_polish_config -- e.g. from a `polish`
src/pipeline/server.py:624:         query param on /rerender. None (the default, used by every caller
src/pipeline/server.py:625:         except the rerender routes) means "no override": fall back to
src/pipeline/server.py:626:         whatever [polish].enabled/provider/model already say in
src/pipeline/server.py:627:         config/models.toml, byte-for-byte the same as before this param
src/pipeline/server.py:628:         existed.
src/pipeline/server.py:629: 
src/pipeline/server.py:630:         claims: the Stage 2 narrative claim list (claims.py shape) the
src/pipeline/server.py:631:         assembled markdown was built to cover, checked against the polish
src/pipeline/server.py:632:         pass's output below -- an empty default (the photo-build call site,
src/pipeline/server.py:633:         which has no narrative claims) makes that check a no-op, byte-for-
src/pipeline/server.py:634:         byte unchanged from before this param existed."""
src/pipeline/server.py:635:         # Optional stage 4: a per-field formatting/tone pass over
src/pipeline/server.py:636:         # narrative_text and each step's text/present narration
src/pipeline/server.py:637:         # (generate_polish_fields, polish.py) -- narration_polish.py's
src/pipeline/server.py:638:         # per-unit pattern, so a bad rewrite of one field can never discard a
src/pipeline/server.py:639:         # good rewrite of another. With no override, gated on
src/pipeline/server.py:640:         # [polish].enabled (default off -- see PolishConfig); an explicit
src/pipeline/server.py:641:         # override bypasses that toggle for this job (resolve_polish_config's
src/pipeline/server.py:642:         # "off" always skips, "local"/"haiku" always run). doc.md, doc.html,
src/pipeline/server.py:643:         # doc.single.html, the md-bundle (export.md.zip), doc.docx, and
src/pipeline/server.py:644:         # doc.pdf all reflect this pass -- all six rendered from the
src/pipeline/server.py:645:         # polished fields below.
src/pipeline/server.py:646:         current_cfg = load_models_config(resolved_config_path)
src/pipeline/server.py:647:         if polish_override is not None:
src/pipeline/server.py:648:             polish_section = resolve_polish_config(polish_override, current_cfg)
src/pipeline/server.py:649:         elif current_cfg.polish.enabled:
src/pipeline/server.py:650:             polish_section = current_cfg.polish
src/pipeline/server.py:651:         else:
src/pipeline/server.py:652:             polish_section = None
src/pipeline/server.py:653: 
src/pipeline/server.py:654:         md_narrative_text = narrative_text
src/pipeline/server.py:655:         md_step_results = step_results
src/pipeline/server.py:656:         if polish_section is not None:
src/pipeline/server.py:657:             polish_llm = make_polish_llm_client(polish_section)
src/pipeline/server.py:658:             try:
src/pipeline/server.py:659:                 md_narrative_text, md_step_results, _polish_meta = generate_polish_fields(
src/pipeline/server.py:660:                     narrative_text, step_results, polish_llm
src/pipeline/server.py:661:                 )
src/pipeline/server.py:662:             finally:
src/pipeline/server.py:663:                 close = getattr(polish_llm, "close", None)
src/pipeline/server.py:664:                 if callable(close):
src/pipeline/server.py:665:                     close()
src/pipeline/server.py:666:             # Safety net for invariant L4 (CLAUDE.md): generate_polish_fields's
src/pipeline/server.py:667:             # own per-field gate (_field_gate) only rejects a rewrite that
src/pipeline/server.py:668:             # ADDS unsupported content -- it has no way to know a claim's
src/pipeline/server.py:669:             # exact text is load-bearing, so nothing stops an otherwise-
src/pipeline/server.py:670:             # faithful rephrase of narrative_text from making a claim's text
src/pipeline/server.py:671:             # (and any [verify] blockquote covering it -- which lives inside
src/pipeline/server.py:672:             # narrative_text itself, see narrative.py's ensure_claim_coverage)
src/pipeline/server.py:673:             # vanish. Re-run the same coverage check doc.md must already
src/pipeline/server.py:674:             # satisfy pre-polish, against the polished narrative specifically
src/pipeline/server.py:675:             # (claims never live in step text/narration); if it broke
src/pipeline/server.py:676:             # coverage, discard just the narrative rewrite and keep the
src/pipeline/server.py:677:             # known-good original narrative_text rather than ship a doc with
src/pipeline/server.py:678:             # a silently dropped claim. Step text/narration polish carries no
src/pipeline/server.py:679:             # such risk and is kept either way.
src/pipeline/server.py:680:             ok, missing = validate_claim_coverage(md_narrative_text, claims)
src/pipeline/server.py:681:             if not ok:
src/pipeline/server.py:682:                 report["polish_rejected_claim_coverage"] = missing
src/pipeline/server.py:683:                 md_narrative_text = narrative_text
src/pipeline/server.py:684: 
