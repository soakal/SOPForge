src/pipeline/polish.py:236:             return False, "dropped or altered a literal fact"
src/pipeline/polish.py:237: 
src/pipeline/polish.py:238:     # 2. Most meaningful words in the rewrite must trace back to the
src/pipeline/polish.py:239:     # original document. A handful of genuinely new words is tolerated as
src/pipeline/polish.py:240:     # incidental paraphrase vocabulary; a cluster of unsupported new words
src/pipeline/polish.py:241:     # is rejected as invented content -- whether that cluster is large
