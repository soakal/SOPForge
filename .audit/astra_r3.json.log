src/pipeline/config.py:223:     # basic string is illegal -- without this, a multiline model value would
src/pipeline/config.py:224:     # write invalid TOML and brick every subsequent config load).
src/pipeline/config.py:225:     s = str(value).replace("\\", "\\\\").replace('"', '\\"')
