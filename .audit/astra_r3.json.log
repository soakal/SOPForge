config/models.toml:1: # SOPForge model routing. Each section picks a provider (ollama / openrouter /
config/models.toml:2: # openai / anthropic) and a model. API keys are read from environment variables,
config/models.toml:3: # never stored here:
config/models.toml:4: #   openrouter -> OPENROUTER_API_KEY   openai -> OPENAI_API_KEY
config/models.toml:5: #   anthropic  -> ANTHROPIC_API_KEY
config/models.toml:6: # Ollama is local & private (no key). Edit this from the tray's Configuration
config/models.toml:7: # page, or here directly. The runtime copy lives at ~/SOPForge/models.toml.
config/models.toml:8: #
config/models.toml:9: # max_concurrency (steps/vision only): how many LLM calls this section
config/models.toml:10: # dispatches at once. Multi-GPU Ollama hosts auto-split a model's layers
config/models.toml:11: # across GPUs already -- that's about fitting a model, not speed. Raising
config/models.toml:12: # max_concurrency is the actual lever for a speedup, and only helps if the
config/models.toml:13: # Ollama server itself is tuned for concurrent requests (OLLAMA_NUM_PARALLEL
config/models.toml:14: # > 1, optionally OLLAMA_SCHED_SPREAD=1 to spread load across GPUs) -- that's
config/models.toml:15: # server-side config this app cannot set remotely. Against an untuned
config/models.toml:16: # single-slot server, raising this just queues requests and risks a queued
config/models.toml:17: # step's own timeout expiring into a template fallback it didn't need.
config/models.toml:18: 
config/models.toml:19: [steps]
config/models.toml:20: provider = "ollama"
config/models.toml:21: endpoint = "http://192.168.200.60:11434/v1"
config/models.toml:22: model = "qwen3:32b"
config/models.toml:23: max_concurrency = 1
config/models.toml:24: 
config/models.toml:25: [narrative]
config/models.toml:26: provider = "ollama"
config/models.toml:27: endpoint = "http://192.168.200.60:11434/v1"
config/models.toml:28: model = "qwen3.6:27b"
config/models.toml:29: passes = 3
config/models.toml:30: 
config/models.toml:31: [vision]
config/models.toml:32: enabled = true
config/models.toml:33: provider = "ollama"
config/models.toml:34: endpoint = "http://192.168.200.60:11434/v1"
config/models.toml:35: model = "qwen2.5vl:7b"
config/models.toml:36: max_concurrency = 4
config/models.toml:37: 
config/models.toml:38: # Document metadata: stamped on every generated SOP's title page / revision
config/models.toml:39: # table. doc_no_prefix, if set, becomes e.g. "SOP-001" for session 1 -- leave
config/models.toml:40: # blank to omit the document-number line entirely.
config/models.toml:41: [document]
config/models.toml:42: author = "SOPForge"
config/models.toml:43: doc_no_prefix = ""
config/models.toml:44: 
config/models.toml:45: # Optional 4th stage: one formatting/tone pass over the assembled document
config/models.toml:46: # (see src/pipeline/polish.py). Off by default -- the model below
config/models.toml:47: # (gemma3:12b) is confirmed live on this deployment's Ollama host
config/models.toml:48: # (192.168.200.60:11434) and produced a genuine, gate-passing rewrite in
config/models.toml:49: # live testing on 2026-07-11. gemma3n:e4b was tried first but consistently
config/models.toml:50: # echoed the input document back unchanged instead of rewriting it (0/4
config/models.toml:51: # genuine rewrites across two prompt variants, including one with an
config/models.toml:52: # explicit "say NO_CHANGES if nothing to fix" escape hatch) -- ruled out as
config/models.toml:53: # a prompt-wording issue, treated as a model-capability limitation at that
config/models.toml:54: # size. Review the polish stage's output on a sample document before
config/models.toml:55: # setting enabled = true.
config/models.toml:56: #
config/models.toml:57: # The `polish` query param on POST /sessions/{id}/rerender (and
config/models.toml:58: # /ui/sessions/{id}/rerender) overrides this section for a single re-render
config/models.toml:59: # job without editing this file: "off" skips the stage even if enabled here
config/models.toml:60: # is true, "local" forces the ollama provider (keeping this section's own
config/models.toml:61: # endpoint/model), "haiku" forces Anthropic's Claude Haiku 4.5. Omitting the
config/models.toml:62: # param leaves the enabled/provider/model below in full effect. See
config/models.toml:63: # resolve_polish_config in src/pipeline/config.py.
config/models.toml:64: [polish]
config/models.toml:65: enabled = false
config/models.toml:66: provider = "ollama"
config/models.toml:67: endpoint = "http://192.168.200.60:11434/v1"
config/models.toml:68: model = "gemma3:12b"
